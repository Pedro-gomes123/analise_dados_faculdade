MONGODB_URI=
MONGODB_DATABASE=operacional_db

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_STORAGE_ACCOUNT_URL=https://vigiarecifestorage.blob.core.windows.net
AZURE_STORAGE_CONTAINER=vigia-bronze

# Azure SQL / SQL Server
SQL_SERVER=srv-proj5-dev.database.windows.net
SQL_DATABASE=db_monitoramento
SQL_PORT=1433
# SQL_DRIVER só é necessário se optar por usar pyodbc; o padrão mssql-python
# inclui os componentes do driver e não requer instalação ODBC do sistema.
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_AUTH_MODE=ActiveDirectoryInteractive
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=no

# SQL_AUTH_MODE aceita ActiveDirectoryInteractive, ActiveDirectoryServicePrincipal
# ou SqlPassword. Se omitido, a aplicação seleciona SqlPassword quando
# SQL_USERNAME e SQL_PASSWORD estão preenchidos; caso contrário, MFA interativo.
# SQL_USERNAME=vigia_operator
# SQL_PASSWORD=

# Somente para SQL_AUTH_MODE=ActiveDirectoryServicePrincipal:
# SQL_TENANT_ID=
# SQL_CLIENT_ID=
# SQL_CLIENT_SECRET=

# Somente para SQL_AUTH_MODE=SqlPassword, se desejar selecionar explicitamente.
