# API
NODE_ENV=development
PORT=3000

# SQL Server local (compose.yml). Senha precisa ter 8+ caracteres, com maiúscula, minúscula, número e símbolo.
MSSQL_SA_PASSWORD=TroqueEsta_Senha1

# Conexão do back com o banco. Rodando o back fora do Docker, DB_HOST=localhost;
# dentro do compose, o compose.yml troca para DB_HOST=db.
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
# Mesma senha do MSSQL_SA_PASSWORD
DB_PASSWORD=TroqueEsta_Senha1
DB_NAME=vigia
DB_ENCRYPT=true
# true só no SQL Server local (certificado autoassinado); no Azure SQL, false
DB_TRUST_SERVER_CERTIFICATE=true

# Autenticação (DEC-013). Segredo com 32+ caracteres; gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais
JWT_EXPIRES_IN=8h

# Primeiro administrador (TASK-016), usado só por `npm run seed:admin`.
# Idempotente: se já existe um ADM, nada é alterado. Senha com 8+ caracteres (PR-020).
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@exemplo.gov.br
ADMIN_SENHA=troque-esta-senha
